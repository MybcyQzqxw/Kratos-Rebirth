<div id="kratos-wrapper">
    <div id="kratos-page">
        <div id="kratos-header">
            <header id="kratos-desktop-topnav" class="kratos-topnav">
                <div class="container">
                    <div class="nav-header">
                        <nav id="kratos-menu-wrap">
                            <ul id="kratos-primary-menu" class="sf-menu">
                                <% for (const item of theme.nav.items) { %>
                                    <li<% if (item.float_right) { %> class="right"<% } %>>
                                        <% if (item.submenu) { %>
                                            <a>
                                        <% } else { %>
                                            <a href="<%- url_for(item.url) %>">
                                        <% } %>
                                            <% if (item.icon) { %>
                                                <%- icon_to_html(item.icon) %>
                                            <% } %>
                                            <%- item.label %>
                                        </a>
                                        <% if (item.submenu) { %>
                                            <ul class="sub-menu">
                                                <% for (const submenu of item.submenu) { %>
                                                    <li>
                                                        <a href="<%- url_for(submenu.url) %>">
                                                            <% if (submenu.icon) { %>
                                                                <%- icon_to_html(submenu.icon) %>
                                                            <% } %>
                                                            <%- submenu.label %>
                                                        </a>
                                                    </li>
                                                <% } %>
                                            </ul>
                                        <% } %>
                                    </li>
                                <% } %>
                            </ul>
                        </nav>
                    </div>
                </div>
            </header>
            <header id="kratos-mobile-topnav" class="kratos-topnav">
                <div class="container">
                    <div class="color-logo"><a href="<%- url_for() %>"><%= config.title %></a></div>
                    <div id="kratos-nav-toggle-wrapper" class="nav-toggle">
                        <a id="kratos-nav-toggle" class="kratos-nav-toggle">
                            <i></i>
                        </a>
                    </div>
                </div>
            </header>
        </div>
        <%
            // 计算非首页横幅展示的板块名称（板块横幅内容）
            let bannerTitle = '';
            let bannerSubtitle = '';
            if (is_archive()) {
                bannerTitle = __('title.archive');
                if (is_month()) {
                    bannerTitle += ': ' + page.year + '-' + String(page.month).padStart(2, '0');
                } else if (is_year()) {
                    bannerTitle += ': ' + page.year;
                }
            } else if (is_category()) {
                bannerTitle = __('title.category');
                bannerSubtitle = page.category;
            } else if (is_tag()) {
                bannerTitle = __('title.tag');
                bannerSubtitle = page.tag;
            } else if (is_post()) {
                bannerTitle = page.title || __('title.status');
            } else {
                bannerTitle = page.title || (page.title_i18n ? __(page.title_i18n) : '') || config.title;
            }
        %>
        <div id="kr-banner-zone">
            <% if (is_home()) { %>
                <!-- 首页专属全屏封面：初次进入占满全屏，下拉后与主界面自然衔接；一旦完全滚入主界面即永久折叠，之后上拉也不会再出现 -->
                <div id="kr-fullpage-cover" class="kr-fullpage-cover">
                    <div class="kr-fullpage-cover-content text-center">
                        <h1><%= config.title %></h1>
                        <% if (config.subtitle) { %>
                            <p><%= config.subtitle %></p>
                        <% } %>
                    </div>
                    <div class="kr-fullpage-cover-arrow">
                        <i class="fa fa-angle-down"></i>
                    </div>
                </div>
            <% } else { %>
                <div class="kratos-start kratos-hero-2">
                    <div class="kratos-cover kratos-cover-2 text-center">
                        <div class="desc desc2 animate-box">
                            <h2><%- bannerTitle %></h2>
                            <% if (bannerSubtitle) { %>
                                <br />
                                <span><%- bannerSubtitle %></span>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>

        <div id="kratos-blog-post">
            <div class="container">
                <div id="main" class="row">
