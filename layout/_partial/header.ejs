<div id="kratos-wrapper">
    <div id="kratos-page">
        <div id="kratos-header">
            <header id="kratos-desktop-topnav" class="kratos-topnav">
                <div class="container">
                    <div class="nav-header">
                        <nav id="kratos-menu-wrap">
                            <ul id="kratos-primary-menu" class="sf-menu">
                                <% for (const item of theme.nav.items) { %>
                                    <li<% if (item.float_right) { %> class="right"<% } %>>
                                        <% if (item.submenu) { %>
                                            <a>
                                        <% } else { %>
                                            <a href="<%- url_for(item.url) %>">
                                        <% } %>
                                            <% if (item.icon) { %>
                                                <%- icon_to_html(item.icon) %>
                                            <% } %>
                                            <%- item.label %>
                                        </a>
                                        <% if (item.submenu) { %>
                                            <ul class="sub-menu">
                                                <% for (const submenu of item.submenu) { %>
                                                    <li>
                                                        <a href="<%- url_for(submenu.url) %>">
                                                            <% if (submenu.icon) { %>
                                                                <%- icon_to_html(submenu.icon) %>
                                                            <% } %>
                                                            <%- submenu.label %>
                                                        </a>
                                                    </li>
                                                <% } %>
                                            </ul>
                                        <% } %>
                                    </li>
                                <% } %>
                            </ul>
                        </nav>
                    </div>
                </div>
            </header>
            <header id="kratos-mobile-topnav" class="kratos-topnav">
                <div class="container">
                    <div class="color-logo"><a href="<%- url_for() %>"><%= config.title %></a></div>
                    <div id="kratos-nav-toggle-wrapper" class="nav-toggle">
                        <a id="kratos-nav-toggle" class="kratos-nav-toggle">
                            <i></i>
                        </a>
                    </div>
                </div>
            </header>
        </div>
        <div id="kr-banner-zone">
            <% if (is_home()) { %>
                <!-- 首页专属全屏封面：初次进入占满全屏，下拉后与主界面自然衔接；一旦完全滚入主界面即永久折叠，之后上拉也不会再出现 -->
                <div id="kr-fullpage-cover" class="kr-fullpage-cover">
                    <div class="kr-fullpage-cover-content text-center">
                        <h1><%= config.title %></h1>
                        <% if (config.subtitle) { %>
                            <p><%= config.subtitle %></p>
                        <% } %>
                    </div>
                    <div class="kr-fullpage-cover-arrow">
                        <i class="fa fa-angle-down"></i>
                    </div>
                </div>
            <% } %>
            <!-- 非首页不显示横幅，仅由 #kr-banner-zone 的 padding 为固定导航栏留白 -->
        </div>

        <div id="kratos-blog-post">
            <div class="container">
                <div id="main" class="row">
