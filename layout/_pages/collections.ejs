<% const collections = get_collections(); %>
<article>
  <div class="kratos-hentry kratos-page-inner clearfix">
    <header class="kratos-page-header">
      <h1 class="kratos-page-title text-center" itemprop="name headline"><%- __('title.collection') %></h1>
    </header>
    <div class="kratos-page-content kr-collections">
      <h3 class="archive-page-counter text-center">
        <%- __('list_page_count_message.collections', collections.length) %>
      </h3>
      <div class="col-grid">
        <% collections.forEach((c) => { %>
          <a class="col-card<%= c.cover ? '' : ' no-cover' %>" href="<%- url_for(c.path) %>"<% if (c.cover) { %> style="--cover: url('<%- url_for(c.cover) %>')"<% } %>>
            <span class="col-card-body">
              <span class="col-card-title"><%= c.name %></span>
              <% if (c.description) { %><span class="col-card-desc"><%= c.description %></span><% } %>
              <span class="col-card-count"><i class="fa fa-file-text-o"></i> <%= c.posts.length %> 篇文章</span>
            </span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</article>
