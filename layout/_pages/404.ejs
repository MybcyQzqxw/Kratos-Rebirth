<style>
  .page404 {
    padding: 0 5%;
  }

  .page404 img {
    width: 100%;
    border-radius: 15px;
    background-color: white;
  }

  .page404 .back-p {
    margin-right: 15px;
    padding: 10px 20px;
    border: 1px solid #ec6fa6;
    background: #ec6fa6;
    color: #fff;
    line-height: 3;
  }

  .page404 .back-p:hover {
    background: #d6568c;
    color: #fff !important;
  }

  .page404 .back-index {
    margin-left: 15px;
    padding: 10px 20px;
    border: 1px solid #f0f0f0;
    background-color: #fafafa;
    color: #767676;
    line-height: 3;
  }

  .page404 .back-index:hover {
    border-color: #e0558f;
    color: #e0558f;
  }

  .page404 .errtxt {
    margin-top: 10%;
  }
</style>

<div class="page404">
    <div class="kratos-hentry kratos-page-inner clearfix">
        <div class="col-md-7">
            <img src="<%- url_theme_cdn('images/404.webp') %>" loading="eager" decoding="auto" />
        </div>
        <div class="col-md-5 text-center errtxt">
            <h3>这个页面搬家啦</h3>
            <h5>要不要试着回到主页找一找呢~</h5>
            <p>
                <a href="javascript:history.go(-1)" class="back-p">返回上页</a>
                <a href="<%- url_for() %>" class="back-index">返回主页</a>
            </p>
        </div>
    </div>
</div>
